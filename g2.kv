#:kivy 2.1.0
#:import hex kivy.utils.get_color_from_hex
#:import dp kivy.metrics.dp
#:import NoTransition kivy.uix.screenmanager.NoTransition
#:set BG hex('#0B0B0C')
#:set SURFACE hex('#141416')
#:set SURFACE2 hex('#1C1C1F')
#:set BORDER hex('#2A2A2E')
#:set GOLD hex('#D4AF37')
#:set GOLD_DOWN hex('#B08F2A')
#:set GOLD_DIM hex('#D4AF3726')
#:set TEXT hex('#F2EDE3')
#:set MUTED hex('#8C877D')
#:set DANGER hex('#E5484D')
#:set AMBER hex('#E0A33A')
#:set ONLINE hex('#3FB97A')
#:set INK hex('#0B0B0C')

# ======================================================================
#  Base styles
# ======================================================================
<Label>:
    font_name: "Body"

<Caption@Label>:
    font_size: "11sp"
    bold: True
    color: MUTED
    size_hint_y: None
    height: dp(18)
    text_size: self.size
    halign: "left"
    valign: "middle"

<Hint@Label>:
    font_size: "12sp"
    color: MUTED
    size_hint_y: None
    height: max(self.texture_size[1], dp(16))
    text_size: self.width, None
    halign: "left"

<CardBase@BoxLayout>:
    orientation: "vertical"
    canvas.before:
        Color:
            rgba: SURFACE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]
        Color:
            rgba: BORDER
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(18)
            width: 1

<Card@CardBase>:
    padding: dp(16)
    spacing: dp(12)
    size_hint_y: None
    height: self.minimum_height

<GoldButton@ButtonBehavior+Label>:
    font_name: "Display"
    bold: True
    font_size: "16sp"
    color: INK
    canvas.before:
        Color:
            rgba: GOLD_DOWN if self.state == "down" else GOLD
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

<GhostButton@ButtonBehavior+Label>:
    font_size: "13sp"
    bold: True
    color: GOLD
    canvas.before:
        Color:
            rgba: GOLD_DIM if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        Color:
            rgba: GOLD[:3] + [0.45]
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(10)
            width: 1

<IconButton@ButtonBehavior+Label>:
    font_name: "Display"
    font_size: "22sp"
    color: GOLD
    size_hint_x: None
    width: dp(44)
    canvas.before:
        Color:
            rgba: GOLD_DIM if self.state == "down" else SURFACE2
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

<Chip>:
    font_size: "13sp"
    bold: True
    size_hint: None, None
    height: dp(32)
    width: self.texture_size[0] + dp(26)
    color: INK if self.active else TEXT
    canvas.before:
        Color:
            rgba: GOLD if self.active else (GOLD_DIM if self.state == "down" else SURFACE2)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: (0, 0, 0, 0) if self.active else BORDER
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(16)
            width: 1

<StarButton>:
    size_hint: None, None
    size: dp(48), dp(48)
    canvas.before:
        Color:
            rgba: GOLD_DIM if self.state == "down" else SURFACE2
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: GOLD if self.active else BORDER
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(12)
            width: 1
    canvas:
        Color:
            rgba: GOLD if self.active else (0, 0, 0, 0)
        Mesh:
            vertices: self.mesh_vertices
            indices: self.mesh_indices
            mode: "triangle_fan"
        Color:
            rgba: GOLD if self.active else MUTED
        Line:
            points: self.star_points
            close: True
            width: 1.3
            joint: "round"

<Segment@ToggleButtonBehavior+Label>:
    allow_no_selection: False
    font_size: "13sp"
    bold: True
    color: INK if self.state == "down" else MUTED
    canvas.before:
        Color:
            rgba: GOLD if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x + dp(3), self.y + dp(3)
            size: self.width - dp(6), self.height - dp(6)
            radius: [dp(10)]

<SegmentBar@BoxLayout>:
    size_hint_y: None
    height: dp(46)
    canvas.before:
        Color:
            rgba: SURFACE2
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(13)]

<GField@TextInput>:
    multiline: False
    write_tab: False
    size_hint_y: None
    height: dp(48)
    font_name: "Body"
    font_size: "15sp"
    background_normal: ""
    background_active: ""
    background_color: 0, 0, 0, 0
    foreground_color: TEXT
    hint_text_color: MUTED
    cursor_color: GOLD
    selection_color: GOLD[:3] + [0.35]
    padding: dp(14), (dp(12) if self.multiline else (self.height - self.line_height) / 2)
    canvas.before:
        Color:
            rgba: SURFACE2
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: GOLD if self.focus else BORDER
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(12)
            width: 1.2 if self.focus else 1
        # TextInput draws its text with the last Color set in canvas.before,
        # so restore the text colour after drawing the border.
        Color:
            rgba: self.disabled_foreground_color if self.disabled else (self.hint_text_color if not self.text else self.foreground_color)

<GOption@SpinnerOption>:
    font_name: "Body"
    font_size: "15sp"
    background_normal: ""
    background_color: SURFACE2 if self.state == "normal" else GOLD_DOWN
    color: TEXT
    height: dp(46)
    padding: dp(14), 0
    text_size: self.size
    halign: "left"
    valign: "middle"
    shorten: True
    shorten_from: "right"

<GSpinner@Spinner>:
    option_cls: "GOption"
    size_hint_y: None
    height: dp(48)
    font_size: "15sp"
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: TEXT
    padding: dp(14), 0, dp(40), 0
    text_size: self.size
    halign: "left"
    valign: "middle"
    shorten: True
    shorten_from: "right"
    canvas.before:
        Color:
            rgba: SURFACE2
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: GOLD if self.is_open else BORDER
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(12)
            width: 1
    canvas.after:
        Color:
            rgba: GOLD
        Line:
            points: self.right - dp(24), self.center_y + dp(2), self.right - dp(19), self.center_y - dp(3), self.right - dp(14), self.center_y + dp(2)
            width: 1.4
            cap: "round"
            joint: "round"

<Row@Collapsible>:
    size_hint_y: None
    height: dp(48)
    spacing: dp(10)

<FieldGroup@BoxLayout>:
    orientation: "vertical"
    spacing: dp(6)
    size_hint_y: None
    height: dp(72)

<RV@RecycleView>:
    bar_width: dp(3)
    bar_color: GOLD[:3] + [0.7]
    bar_inactive_color: GOLD[:3] + [0.2]
    scroll_type: ["bars", "content"]

<EmptyLabel@Label>:
    markup: True
    font_size: "14sp"
    color: MUTED
    text_size: self.width * 0.8, None
    halign: "center"
    valign: "middle"

# ======================================================================
#  List rows
# ======================================================================
<ListRowBase@ButtonBehavior+BoxLayout>:
    canvas.before:
        Color:
            rgba: GOLD_DIM if self.state == "down" else (0, 0, 0, 0)
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: BORDER[:3] + [0.6]
        Rectangle:
            pos: self.x, self.y
            size: self.width, 1

<ImeiRow>:
    size_hint_y: None
    height: dp(44)
    padding: dp(4), 0
    canvas.before:
        Color:
            rgba: GOLD_DIM if self.state == "down" else (0, 0, 0, 0)
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: BORDER[:3] + [0.6]
        Rectangle:
            pos: self.x, self.y
            size: self.width, 1
    Label:
        text: root.num
        font_name: "Mono"
        font_size: "12sp"
        color: MUTED
        size_hint_x: None
        width: dp(40)
    Label:
        text: root.markup
        markup: True
        font_name: "Mono"
        font_size: "17sp"
        text_size: self.size
        halign: "left"
        valign: "middle"
    Label:
        text: "COPY"
        font_size: "10sp"
        bold: True
        color: MUTED
        size_hint_x: None
        width: dp(44)

<BulkRow>:
    size_hint_y: None
    height: dp(54)
    padding: dp(4), 0
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: GOLD_DIM if self.state == "down" else (0, 0, 0, 0)
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: BORDER[:3] + [0.6]
        Rectangle:
            pos: self.x, self.y
            size: self.width, 1
    BoxLayout:
        orientation: "vertical"
        padding: 0, dp(6)
        Label:
            text: root.markup
            markup: True
            font_name: "Mono"
            font_size: "15sp"
            text_size: self.size
            halign: "left"
            valign: "middle"
            shorten: True
            shorten_from: "right"
        Label:
            text: root.device
            font_size: "12sp"
            color: MUTED
            text_size: self.size
            halign: "left"
            valign: "middle"
            shorten: True
            shorten_from: "right"
    Label:
        text: {"valid": "VALID", "unknown": "UNKNOWN", "test": "TEST"}.get(root.verdict, "INVALID")
        font_size: "10sp"
        bold: True
        color: {"valid": GOLD, "unknown": AMBER, "test": AMBER}.get(root.verdict, DANGER)
        size_hint: None, None
        size: dp(70), dp(24)
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: {"valid": GOLD, "unknown": AMBER, "test": AMBER}.get(root.verdict, DANGER)[:3] + [0.5]
            Line:
                rounded_rectangle: self.x, self.y, self.width, self.height, dp(12)
                width: 1

<HistoryRow>:
    size_hint_y: None
    height: dp(60)
    padding: dp(6), 0, 0, 0
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: GOLD_DIM if self.state == "down" else (0, 0, 0, 0)
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: BORDER[:3] + [0.6]
        Rectangle:
            pos: self.x, self.y
            size: self.width, 1
    BoxLayout:
        orientation: "vertical"
        padding: 0, dp(9)
        Label:
            text: root.title
            font_name: "Display"
            bold: True
            font_size: "15sp"
            color: TEXT
            text_size: self.size
            halign: "left"
            valign: "middle"
            shorten: True
            shorten_from: "right"
        Label:
            text: root.meta
            font_size: "12sp"
            color: MUTED
            text_size: self.size
            halign: "left"
            valign: "middle"
            shorten: True
            shorten_from: "right"
    GhostButton:
        text: "Copy"
        size_hint: None, None
        size: dp(60), dp(34)
        pos_hint: {"center_y": 0.5}
        on_release: app.copy_history(root.hid)
    IconButton:
        text: "×"
        color: MUTED
        size_hint: None, None
        size: dp(34), dp(34)
        pos_hint: {"center_y": 0.5}
        on_release: app.delete_history(root.hid)

<DetailRow>:
    size_hint_y: None
    height: max(dp(30), val.texture_size[1] + dp(8))
    Label:
        text: root.key
        font_size: "13sp"
        color: MUTED
        size_hint_x: None
        width: dp(104)
        text_size: self.size
        halign: "left"
        valign: "top"
        padding: 0, dp(4)
    Label:
        id: val
        text: root.value
        markup: True
        font_size: "15sp"
        color: TEXT
        text_size: self.width, None
        halign: "left"
        valign: "top"

# ======================================================================
#  Screen
# ======================================================================
<Root>:
    canvas.before:
        Color:
            rgba: BG
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        id: content
        orientation: "vertical"
        padding: dp(16), dp(12), dp(16), dp(12)
        spacing: dp(12)
        opacity: app.content_opacity
        canvas.before:
            PushMatrix
            Translate:
                xy: 0, -app.content_shift
        canvas.after:
            PopMatrix

        # ---------------- header ----------------
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(12)
            Image:
                source: app.logo
                size_hint_x: None
                width: dp(40)
                fit_mode: "contain"
            BoxLayout:
                orientation: "vertical"
                Label:
                    markup: True
                    text: "[color=#D4AF37]G2[/color]  IMEI Generator"
                    font_name: "Display"
                    bold: True
                    font_size: "19sp"
                    color: TEXT
                    text_size: self.size
                    halign: "left"
                    valign: "bottom"
                BoxLayout:
                    spacing: dp(6)
                    Widget:
                        size_hint: None, None
                        size: dp(7), dp(7)
                        pos_hint: {"center_y": 0.62}
                        canvas:
                            Color:
                                rgba: ({"online": ONLINE, "checking": AMBER, "updating": AMBER}.get(app.net_state, MUTED))[:3] + [app.dot_alpha]
                            Ellipse:
                                pos: self.pos
                                size: self.size
                    Label:
                        text: app.db_summary
                        font_size: "12sp"
                        color: MUTED
                        text_size: self.size
                        halign: "left"
                        valign: "top"
                        shorten: True
                        shorten_from: "right"
            GhostButton:
                text: "Exit"
                size_hint: None, None
                size: dp(54), dp(32)
                pos_hint: {"center_y": 0.5}
                color: MUTED
                on_release: app.confirm_exit()

        SegmentBar:
            Segment:
                id: tab_generate
                text: "Generate"
                group: "tab"
                state: "down"
                on_state: if self.state == "down": app.switch_tab("generate")
            Segment:
                id: tab_check
                text: "Check"
                group: "tab"
                on_state: if self.state == "down": app.switch_tab("check")
            Segment:
                id: tab_history
                text: "History"
                group: "tab"
                on_state: if self.state == "down": app.switch_tab("history")

        ScreenManager:
            id: sm
            transition: NoTransition()

            # ================ GENERATE ================
            Screen:
                name: "generate"
                BoxLayout:
                    orientation: "vertical"
                    spacing: dp(12)

                    # Favourites strip (hidden when empty)
                    Collapsible:
                        id: fav_strip
                        size_hint_y: None
                        height: dp(32)
                        ScrollView:
                            do_scroll_y: False
                            bar_width: 0
                            BoxLayout:
                                id: fav_box
                                size_hint_x: None
                                width: self.minimum_width
                                spacing: dp(8)

                    Card:
                        padding: dp(14)
                        spacing: dp(10)
                        SegmentBar:
                            height: dp(42)
                            Segment:
                                id: mode_esim
                                text: "eSIM iPhone"
                                group: "mode"
                                state: "down"
                                on_state: if self.state == "down": app.set_mode("esim")
                            Segment:
                                id: mode_all
                                text: "Database"
                                group: "mode"
                                on_state: if self.state == "down": app.set_mode("all")
                            Segment:
                                id: mode_custom
                                text: "Custom TAC"
                                group: "mode"
                                on_state: if self.state == "down": app.set_mode("custom")

                        Row:
                            id: brand_row
                            GSpinner:
                                id: brand
                                on_text: app.refresh_models()
                            GField:
                                id: search
                                hint_text: "Search model or TAC"
                                on_text: app.search_trigger()

                        Row:
                            id: model_row
                            GSpinner:
                                id: model
                                on_text: app.update_tac_info()
                            StarButton:
                                id: star_model
                                on_release: app.toggle_favorite()

                        Row:
                            id: custom_row
                            GField:
                                id: custom_tac
                                hint_text: "8-digit TAC, e.g. 35104463"
                                input_filter: "int"
                                font_name: "Mono"
                                on_text: app.update_tac_info()
                            StarButton:
                                id: star_custom
                                on_release: app.toggle_favorite()

                        Hint:
                            id: tac_info

                        BoxLayout:
                            size_hint_y: None
                            height: dp(50)
                            spacing: dp(8)
                            IconButton:
                                text: "−"
                                on_release: app.step_qty(-1)
                            GField:
                                id: qty
                                text: "10"
                                input_filter: "int"
                                font_name: "Mono"
                                halign: "center"
                                size_hint_x: None
                                width: dp(64)
                                height: dp(50)
                                padding: dp(6), (self.height - self.line_height) / 2
                                on_text: app.update_qty_chips()
                            IconButton:
                                text: "+"
                                on_release: app.step_qty(1)
                            Widget:
                                size_hint_x: None
                                width: dp(4)
                            GoldButton:
                                text: "Generate"
                                on_release: app.generate()

                        BoxLayout:
                            id: qty_chips
                            size_hint_y: None
                            height: dp(32)
                            spacing: dp(8)

                    # ---------------- results ----------------
                    CardBase:
                        padding: dp(14), dp(10), dp(14), dp(10)
                        spacing: dp(6)
                        BoxLayout:
                            orientation: "vertical"
                            size_hint_y: None
                            height: dp(38)
                            Label:
                                text: app.results_title
                                font_name: "Display"
                                bold: True
                                font_size: "15sp"
                                color: TEXT
                                text_size: self.size
                                halign: "left"
                                valign: "middle"
                                shorten: True
                                shorten_from: "right"
                            Label:
                                text: app.results_subtitle
                                font_size: "11sp"
                                color: MUTED
                                text_size: self.size
                                halign: "left"
                                valign: "middle"
                                shorten: True
                                shorten_from: "right"
                        FloatLayout:
                            RV:
                                id: rv
                                pos_hint: {"x": 0, "y": 0}
                                size_hint: 1, 1
                                viewclass: "ImeiRow"
                                RecycleBoxLayout:
                                    default_size: None, dp(44)
                                    default_size_hint: 1, None
                                    size_hint_y: None
                                    height: self.minimum_height
                                    orientation: "vertical"
                            EmptyLabel:
                                id: empty
                                pos_hint: {"x": 0, "y": 0}
                                size_hint: 1, 1
                                text: app.empty_text
                        BoxLayout:
                            size_hint_y: None
                            height: dp(38)
                            spacing: dp(8)
                            GSpinner:
                                id: fmt
                                height: dp(38)
                                font_size: "13sp"
                                values: app.format_labels
                                text: app.format_labels[0]
                                on_text: app.save_settings()
                            GhostButton:
                                text: "Copy"
                                size_hint_x: None
                                width: dp(62)
                                on_release: app.copy_results()
                            GhostButton:
                                text: app.export_label
                                size_hint_x: None
                                width: dp(62)
                                on_release: app.export_results()
                            GhostButton:
                                text: "Clear"
                                size_hint_x: None
                                width: dp(56)
                                on_release: app.clear_results()

            # ================ CHECK ================
            Screen:
                name: "check"
                BoxLayout:
                    orientation: "vertical"
                    spacing: dp(12)
                    SegmentBar:
                        height: dp(42)
                        Segment:
                            id: check_single
                            text: "Single"
                            group: "check"
                            state: "down"
                            on_state: if self.state == "down": app.set_check_mode("single")
                        Segment:
                            id: check_bulk
                            text: "Bulk"
                            group: "check"
                            on_state: if self.state == "down": app.set_check_mode("bulk")

                    ScreenManager:
                        id: check_sm
                        transition: NoTransition()

                        Screen:
                            name: "single"
                            BoxLayout:
                                orientation: "vertical"
                                spacing: dp(12)
                                Card:
                                    Caption:
                                        text: "IMEI OR TAC"
                                    Row:
                                        GField:
                                            id: check_input
                                            hint_text: "15-digit IMEI or 8-digit TAC"
                                            input_type: "number"
                                            font_name: "Mono"
                                            on_text_validate: app.check()
                                        GhostButton:
                                            text: "Paste"
                                            size_hint_x: None
                                            width: dp(70)
                                            on_release: app.paste_into(check_input, single=True)
                                    GoldButton:
                                        text: "Check"
                                        size_hint_y: None
                                        height: dp(50)
                                        on_release: app.check()
                                Card:
                                    id: check_card
                                    opacity: 0
                                    Label:
                                        id: check_status
                                        markup: True
                                        font_name: "Display"
                                        bold: True
                                        font_size: "17sp"
                                        color: TEXT
                                        size_hint_y: None
                                        height: max(self.texture_size[1], dp(24))
                                        text_size: self.width, None
                                        halign: "left"
                                    BoxLayout:
                                        id: details
                                        orientation: "vertical"
                                        size_hint_y: None
                                        height: self.minimum_height
                                Widget:
                                BoxLayout:
                                    size_hint_y: None
                                    height: dp(34)
                                    spacing: dp(8)
                                    Label:
                                        text: app.update_status
                                        font_size: "12sp"
                                        color: TEXT
                                        text_size: self.size
                                        halign: "left"
                                        valign: "middle"
                                        shorten: True
                                        shorten_from: "right"
                                    GhostButton:
                                        text: "Checking…" if app.net_state in ("checking", "updating") else "Update database"
                                        size_hint_x: None
                                        width: dp(130)
                                        disabled: app.net_state in ("checking", "updating")
                                        on_release: app.start_db_update(manual=True)
                                Hint:
                                    text: app.db_info
                                Hint:
                                    text: "For testing only. Do not use generated numbers on a live network or to impersonate a real device."

                        Screen:
                            name: "bulk"
                            BoxLayout:
                                orientation: "vertical"
                                spacing: dp(12)
                                Card:
                                    padding: dp(14)
                                    spacing: dp(10)
                                    GField:
                                        id: bulk_input
                                        multiline: True
                                        height: dp(120)
                                        font_name: "Mono"
                                        font_size: "14sp"
                                        hint_text: "Paste IMEIs: one per line, or separated by commas"
                                    Row:
                                        GhostButton:
                                            text: "Paste"
                                            on_release: app.paste_into(bulk_input)
                                        GhostButton:
                                            text: "Clear"
                                            on_release: app.clear_bulk()
                                        GoldButton:
                                            text: "Check all"
                                            on_release: app.bulk_check()
                                CardBase:
                                    padding: dp(14), dp(10), dp(14), dp(10)
                                    spacing: dp(6)
                                    Label:
                                        text: app.bulk_summary
                                        markup: True
                                        font_name: "Display"
                                        bold: True
                                        font_size: "15sp"
                                        color: TEXT
                                        size_hint_y: None
                                        height: dp(30)
                                        text_size: self.size
                                        halign: "left"
                                        valign: "middle"
                                        shorten: True
                                        shorten_from: "right"
                                    FloatLayout:
                                        RV:
                                            id: bulk_rv
                                            pos_hint: {"x": 0, "y": 0}
                                            size_hint: 1, 1
                                            viewclass: "BulkRow"
                                            RecycleBoxLayout:
                                                default_size: None, dp(54)
                                                default_size_hint: 1, None
                                                size_hint_y: None
                                                height: self.minimum_height
                                                orientation: "vertical"
                                        EmptyLabel:
                                            id: bulk_empty
                                            pos_hint: {"x": 0, "y": 0}
                                            size_hint: 1, 1
                                            text: "Paste a list and tap [color=#D4AF37]Check all[/color]."
                                    BoxLayout:
                                        size_hint_y: None
                                        height: dp(38)
                                        spacing: dp(8)
                                        GhostButton:
                                            text: "Copy valid"
                                            on_release: app.copy_bulk_valid()
                                        GhostButton:
                                            text: "Copy invalid"
                                            on_release: app.copy_bulk_invalid()
                                        GhostButton:
                                            text: "Share report" if app.export_label == "Share" else "Save report"
                                            on_release: app.export_bulk_report()

            # ================ HISTORY ================
            Screen:
                name: "history"
                CardBase:
                    padding: dp(14), dp(10), dp(14), dp(10)
                    spacing: dp(6)
                    BoxLayout:
                        size_hint_y: None
                        height: dp(38)
                        Label:
                            text: app.history_title
                            font_name: "Display"
                            bold: True
                            font_size: "15sp"
                            color: TEXT
                            text_size: self.size
                            halign: "left"
                            valign: "middle"
                        GhostButton:
                            text: "Clear all"
                            size_hint_x: None
                            width: dp(80)
                            on_release: app.clear_history()
                    FloatLayout:
                        RV:
                            id: history_rv
                            pos_hint: {"x": 0, "y": 0}
                            size_hint: 1, 1
                            viewclass: "HistoryRow"
                            RecycleBoxLayout:
                                default_size: None, dp(60)
                                default_size_hint: 1, None
                                size_hint_y: None
                                height: self.minimum_height
                                orientation: "vertical"
                        EmptyLabel:
                            id: history_empty
                            pos_hint: {"x": 0, "y": 0}
                            size_hint: 1, 1
                            text: "Batches you generate are kept here.\nTap one to open it again."
                    Hint:
                        text: "Tap a batch to open it. Copy uses the format chosen on the Generate tab."

    # ---------------- snackbar ----------------
    Label:
        id: snack
        opacity: 0
        markup: True
        size_hint: None, None
        # Full-width bar: its width depends only on the screen, never on its
        # own text (a text-dependent width caused a layout feedback loop).
        size: root.width - dp(36), dp(46)
        pos: dp(18), dp(22)
        font_size: "14sp"
        color: TEXT
        shorten: True
        shorten_from: "right"
        text_size: self.width - dp(24), None
        halign: "center"
        canvas.before:
            Color:
                rgba: SURFACE2
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(14)]
            Color:
                rgba: GOLD[:3] + [0.6]
            Line:
                rounded_rectangle: self.x, self.y, self.width, self.height, dp(14)
                width: 1

    # ---------------- database update: top progress line ----------------
    Widget:
        size_hint: None, None
        size: root.width, dp(3)
        pos: 0, root.top - dp(3)
        opacity: app.bar_opacity
        canvas:
            Color:
                rgba: GOLD[:3] + [0.18]
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba: GOLD
            Rectangle:
                # determinate while downloading, a sweeping segment while checking
                pos: (self.x, self.y) if app.update_progress >= 0 else (self.x + (app.shimmer * 1.4 - 0.4) * self.width, self.y)
                size: (self.width * app.update_progress, self.height) if app.update_progress >= 0 else (self.width * 0.4, self.height)

    # ---------------- database update: success banner ----------------
    BoxLayout:
        size_hint: None, None
        size: root.width - dp(32), dp(64)
        pos: dp(16), root.top - dp(78) + app.banner_offset
        opacity: app.banner_opacity
        padding: dp(14), dp(10)
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: SURFACE2
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(16)]
            Color:
                rgba: GOLD[:3] + [0.7]
            Line:
                rounded_rectangle: self.x, self.y, self.width, self.height, dp(16)
                width: 1.1
        CheckMark:
            size_hint: None, None
            size: dp(40), dp(40)
            pos_hint: {"center_y": 0.5}
            progress: app.banner_check
        BoxLayout:
            orientation: "vertical"
            Label:
                text: app.banner_title
                font_name: "Display"
                bold: True
                font_size: "15sp"
                color: TEXT
                text_size: self.size
                halign: "left"
                valign: "bottom"
                shorten: True
                shorten_from: "right"
            Label:
                text: app.banner_sub
                font_size: "12sp"
                color: MUTED
                text_size: self.size
                halign: "left"
                valign: "top"
                shorten: True
                shorten_from: "right"

    # ---------------- boot intro (removed when finished) ----------------
    Splash:
        id: splash
        canvas.before:
            Color:
                rgba: BG
            Rectangle:
                pos: self.pos
                size: self.size
        Widget:
            id: ring
            canvas:
                Color:
                    rgba: GOLD[:3] + [0.14]
                Line:
                    circle: root.center_x, root.center_y + dp(40), dp(76)
                    width: dp(1.2)
                Color:
                    rgba: GOLD
                Line:
                    circle: root.center_x, root.center_y + dp(40), dp(76), 0, app.splash_angle
                    width: dp(2)
                    cap: "round"
        Image:
            source: app.logo
            size_hint: None, None
            size: dp(104) * app.splash_logo_scale, dp(104) * app.splash_logo_scale
            center: root.center_x, root.center_y + dp(40)
            fit_mode: "contain"
        Label:
            markup: True
            text: "[color=#D4AF37]G2[/color]  IMEI Generator"
            font_name: "Display"
            bold: True
            font_size: "24sp"
            color: TEXT
            opacity: app.splash_text_opacity
            size_hint: None, None
            size: root.width, dp(34)
            pos: 0, root.center_y - dp(84) - (1 - app.splash_text_opacity) * dp(14)
            halign: "center"
            text_size: self.size
        Label:
            text: app.splash_status
            font_size: "13sp"
            color: MUTED
            opacity: app.splash_text_opacity
            size_hint: None, None
            size: root.width, dp(22)
            pos: 0, root.center_y - dp(112)
            halign: "center"
            text_size: self.size

<ExitDialog@ModalView>:
    size_hint: None, None
    size: min(dp(320), app.root.width - dp(48)) if app.root else dp(300), dp(176)
    auto_dismiss: True
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.6
    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(14)
        canvas.before:
            Color:
                rgba: SURFACE
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(18)]
            Color:
                rgba: GOLD[:3] + [0.5]
            Line:
                rounded_rectangle: self.x, self.y, self.width, self.height, dp(18)
                width: 1
        Label:
            text: "Close G2 IMEI Generator?"
            font_name: "Display"
            bold: True
            font_size: "17sp"
            color: TEXT
            size_hint_y: None
            height: dp(26)
            text_size: self.size
            halign: "left"
        Label:
            text: "Your settings, favourites and history are saved."
            font_size: "13sp"
            color: MUTED
            text_size: self.width, None
            halign: "left"
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(10)
            GhostButton:
                text: "Cancel"
                on_release: root.dismiss()
            GoldButton:
                text: "Exit"
                on_release: root.dismiss(); app.exit_app()

<CheckMark>:
    canvas:
        Color:
            rgba: GOLD[:3] + [0.16 * min(1, self.progress * 3)]
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: GOLD
        Line:
            points: self.points
            width: dp(1.8)
            cap: "round"
            joint: "round"
